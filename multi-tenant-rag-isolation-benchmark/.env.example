# Only needed for a live run. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# VOYAGE_BASE_URL=https://api.voyageai.com/v1   (default; set it for a MongoDB Atlas key)
# A Postgres superuser URL with pgvector available; the harness creates and drops its own database.
DATABASE_URL_ADMIN=postgresql://postgres@localhost:5432/postgres
